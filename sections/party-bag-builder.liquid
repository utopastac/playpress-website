<script src="{{ 'party-bag-builder.js' | asset_url }}" defer></script>
{{ 'party-bag-builder.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign party_bag_collection = section.settings.collection
  assign config_tiers = blank

  if shop.metafields.party_bag.config != blank
    assign party_bag_config = shop.metafields.party_bag.config.value
    if party_bag_config.tiers == blank
      assign party_bag_config = shop.metafields.party_bag.config.value | parse_json
    endif
    if party_bag_config.tiers != blank
      assign config_tiers = party_bag_config.tiers
    endif
  endif

  capture discount_tiers
    echo '['
    assign first_tier = true

    if config_tiers != blank
      for tier in config_tiers
        assign min_qty = tier.minQty | default: tier.min_qty | default: 0
        assign discount = tier.discount | default: 0
        if min_qty > 0
          unless first_tier
            echo ','
          endunless
          echo '{"minQty":' | append: min_qty | append: ',"discount":' | append: discount | append: '}'
          assign first_tier = false
        endif
      endfor
    else
      for i in (1..4)
        assign min_key = 'tier_' | append: i | append: '_min_qty'
        assign disc_key = 'tier_' | append: i | append: '_discount'
        assign min_qty = section.settings[min_key]
        if min_qty > 0
          unless first_tier
            echo ','
          endunless
          echo '{"minQty":' | append: min_qty | append: ',"discount":' | append: section.settings[disc_key] | append: '}'
          assign first_tier = false
        endif
      endfor
    endif

    echo ']'
  endcapture
-%}

<section
  is="party-bag-builder"
  style="
    --party-bag-bg: {{ section.settings.background_color }};
    --party-bag-text: {{ section.settings.text_color }};
    --party-bag-price: {{ section.settings.price_color }};
    --party-bag-discount: {{ section.settings.discount_color }};
    --party-bag-card-bg: {{ section.settings.product_card_bg }};
    --party-bag-card-border: {{ section.settings.product_card_border }};
    --party-bag-banner-bg: {{ section.settings.discount_banner_bg }};
    --party-bag-banner-text: {{ section.settings.discount_banner_text }};
    --party-bag-summary-bg: {{ section.settings.summary_bg }};
    --party-bag-summary-border: {{ section.settings.summary_border }};
    --party-bag-btn-bg: {{ section.settings.button_bg_color }};
    --party-bag-btn-text: {{ section.settings.button_text_color }};
    --party-bag-btn-border: {{ section.settings.button_border_color }};
    --party-bag-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --party-bag-btn-hover-text: {{ section.settings.button_hover_text }};
    --party-bag-cta-bg: {{ section.settings.cta_bg_color }};
    --party-bag-cta-text: {{ section.settings.cta_text_color }};
    --party-bag-cta-hover-bg: {{ section.settings.cta_hover_bg }};
    --party-bag-cta-hover-text: {{ section.settings.cta_hover_text }};
    --party-bag-radius: {{ section.settings.border_radius }}px;
    --party-bag-btn-radius: {{ section.settings.button_border_radius }}px;
    --party-bag-title-size: {{ section.settings.title_size }}px;
    --party-bag-description-size: {{ section.settings.description_size }}px;
  "
  data-cart-url="{{ routes.cart_add_url }}"
  data-button-text="{{ section.settings.button_text | escape }}"
  data-discount-tiers='{{ discount_tiers }}'
>
  <div class="party-bag-builder__container">
    <div class="party-bag-builder__header">
      {%- if section.settings.title != blank -%}
        <h2 class="party-bag-builder__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="party-bag-builder__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if party_bag_collection != blank and party_bag_collection.products_count > 0 -%}
      <div class="party-bag-builder__layout">
        <div class="party-bag-builder__products-col">
          <table class="party-bag-builder__products-table">
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col">Price</th>
                <th scope="col">Quantity</th>
              </tr>
            </thead>
            <tbody>
              {%- for product in party_bag_collection.products -%}
                {%- if product.available -%}
                  <tr class="party-bag-builder__product" data-product-card>
                    <td>
                      <div class="party-bag-builder__product-cell">
                        <div class="party-bag-builder__product-image-wrapper">
                          {%- if product.featured_image -%}
                            <img
                              src="{{ product.featured_image | image_url: width: 120 }}"
                              alt="{{ product.featured_image.alt | escape }}"
                              class="party-bag-builder__product-image"
                              loading="lazy"
                              width="60"
                              height="60"
                            >
                          {%- else -%}
                            <div class="party-bag-builder__product-image-placeholder">
                              {{ 'product-1' | placeholder_svg_tag }}
                            </div>
                          {%- endif -%}
                        </div>
                        <span class="party-bag-builder__product-title">{{ product.title }}</span>
                      </div>
                    </td>
                    <td class="party-bag-builder__product-price">{{ product.price | money }}</td>
                    <td>
                      <div class="party-bag-builder__quantity-selector">
                        <button
                          type="button"
                          class="party-bag-builder__quantity-button"
                          data-quantity-decrease
                          data-product-id="{{ product.selected_or_first_available_variant.id }}"
                          data-product-price="{{ product.price }}"
                          aria-label="Decrease quantity"
                          disabled
                        >
                          −
                        </button>
                        <span class="party-bag-builder__quantity-display" data-quantity-display>0</span>
                        <button
                          type="button"
                          class="party-bag-builder__quantity-button"
                          data-quantity-increase
                          data-product-id="{{ product.selected_or_first_available_variant.id }}"
                          data-product-price="{{ product.price }}"
                          aria-label="Increase quantity"
                        >
                          +
                        </button>
                      </div>
                    </td>
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>

        <aside class="party-bag-builder__sidebar">
          <div class="party-bag-builder__checkout" data-spark="b2c-only">
            <div class="party-bag-builder__info">
              <div class="party-bag-builder__discount-status" data-discount-banner>
                <p class="party-bag-builder__discount-current" data-current-tier>
                  Select items to see your discount
                </p>
                <p class="party-bag-builder__discount-next" data-next-tier></p>
              </div>

              <p is="product-price" data-total>{{ 0 | money }}</p>
            </div>

            <form class="party-bag-builder__form">
              <button
                type="button"
                class="add-to-cart"
                data-add-to-cart
                disabled
              >
                {{ section.settings.button_text }}
              </button>
            </form>

            <dl class="party-bag-builder__summary">
              <div>
                <dt>Total items</dt>
                <dd data-total-quantity>0</dd>
              </div>
              <div>
                <dt>Subtotal</dt>
                <dd data-subtotal>{{ 0 | money }}</dd>
              </div>
              <div data-discount-row hidden>
                <dt>Discount</dt>
                <dd class="party-bag-builder__summary-discount" data-discount-amount>−{{ 0 | money }}</dd>
              </div>
            </dl>

            {%- assign has_tiers = false -%}
            {%- if config_tiers != blank -%}
              {%- for tier in config_tiers -%}
                {%- assign tier_min = tier.minQty | default: tier.min_qty | default: 0 -%}
                {%- if tier_min > 0 -%}
                  {%- assign has_tiers = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                {%- assign min_key = 'tier_' | append: i | append: '_min_qty' -%}
                {%- if section.settings[min_key] > 0 -%}
                  {%- assign has_tiers = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- if has_tiers -%}
              <div is="delivery" id="party-bag-tiers">
                <header>
                  <span>Discount tiers</span>
                  <div class="icon chevron-down" id="party-bag-tiers-icon"></div>
                </header>
                <div is="delivery-content">
                  <table>
                    {%- if config_tiers != blank -%}
                      {%- for tier in config_tiers -%}
                        {%- assign tier_min = tier.minQty | default: tier.min_qty | default: 0 -%}
                        {%- assign tier_discount = tier.discount | default: 0 -%}
                        {%- if tier_min > 0 -%}
                          <tr>
                            <td>{{ tier_min }}+ items</td>
                            <td><strong>Save {{ tier_discount }}%</strong></td>
                          </tr>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- else -%}
                      {%- for i in (1..4) -%}
                        {%- assign min_key = 'tier_' | append: i | append: '_min_qty' -%}
                        {%- assign disc_key = 'tier_' | append: i | append: '_discount' -%}
                        {%- assign min_qty = section.settings[min_key] -%}
                        {%- assign discount = section.settings[disc_key] -%}
                        {%- if min_qty > 0 -%}
                          <tr>
                            <td>{{ min_qty }}+ items</td>
                            <td><strong>Save {{ discount }}%</strong></td>
                          </tr>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </table>
                </div>
              </div>
            {%- endif -%}

            <div class="party-bag-builder__message" data-message hidden></div>
          </div>
        </aside>
      </div>
    {%- else -%}
      <div class="party-bag-builder__empty-state">
        <p>Select a party bag collection in the theme editor. Products are managed in that collection in Shopify admin.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Party bag builder",
  "class": "party-bag-builder-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Build Your Party Bag"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Select your favorite items and quantities. The more you add, the more you save!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add to Cart"
